# Version control
.git
.gitignore

# Next.js build output (rebuilt inside Docker)
.next

# Dependencies (reinstalled inside Docker)
node_modules

# Environment & secrets — NEVER ship these to the cloud
.env
.env.*
!.env.example

# Local dev & editor config
.cursor
.vscode
*.code-workspace
.DS_Store

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test & coverage output
coverage
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Python virtual environments (if a backend is added later)
.venv
venv
env
__pycache__
*.pyc

# Docker files themselves (no recursion needed)
Dockerfile*
docker-compose*.yml

# Misc
*.md
README*
